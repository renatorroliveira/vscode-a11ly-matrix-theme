{
    "name": "vscode-a11ly-matrix-theme",
    "displayName": "A11y Matrix Theme",
    "description": "An accessibility-first high contrast dark theme for VS Code with build-time WCAG AAA contrast verification.",
    "version": "0.1.0",
    "publisher": "renatorroliveira",
    "author": {
        "name": "Renato Oliveira",
        "email": "renatorroliveira@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/renatorroliveira/vscode-a11ly-matrix-theme.git"
    },
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "vscode": "^1.125.0",
        "node": "^24.0.0 || >=26.0.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark",
        "high contrast",
        "accessibility",
        "wcag",
        "contrast"
    ],
    "galleryBanner": {
        "color": "#000000",
        "theme": "dark"
    },
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": true
    },
    "contributes": {
        "themes": [
            {
                "id": "A11y Matrix Dark",
                "label": "A11y Matrix Dark",
                "uiTheme": "hc-black",
                "path": "./themes/a11y-matrix-dark-color-theme.json"
            }
        ]
    },
    "scripts": {
        "generate": "node src/build.ts",
        "audit:contrast": "node scripts/contrast-audit.ts",
        "build": "pnpm generate && pnpm audit:contrast",
        "dev": "node --watch src/build.ts",
        "import:seed": "node scripts/import-theme.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
        "package": "pnpm check && vsce package",
        "publish:marketplace": "pnpm check && vsce publish",
        "vscode:prepublish": "node src/build.ts && node scripts/contrast-audit.ts"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.2",
        "@vitest/coverage-v8": "5.1.0",
        "@vscode/vsce": "4.1.0",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.14.0",
        "ovsx": "1.3.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.1.0"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "vsce": {
        "dependencies": false
    }
}
