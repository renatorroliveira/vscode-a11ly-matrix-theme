{
    "name": "ally-dark",
    "displayName": "Ally Dark",
    "description": "An accessibility-first high contrast dark theme for VS Code with build-time WCAG AAA contrast verification.",
    "version": "0.1.0",
    "publisher": "oliveren",
    "author": "Renato Oliveira",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "vscode": "^1.125.0",
        "node": ">=24.0.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark",
        "high contrast",
        "accessibility",
        "wcag",
        "contrast"
    ],
    "galleryBanner": {
        "color": "#000000",
        "theme": "dark"
    },
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": true
    },
    "contributes": {
        "themes": [
            {
                "id": "Ally Dark",
                "label": "Ally Dark",
                "uiTheme": "hc-black",
                "path": "./themes/ally-dark-color-theme.json"
            }
        ]
    },
    "scripts": {
        "generate": "node src/build.ts",
        "audit:contrast": "node scripts/contrast-audit.ts",
        "build": "pnpm generate && pnpm audit:contrast",
        "dev": "node --watch src/build.ts",
        "import:seed": "node scripts/import-theme.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
        "package": "pnpm check && vsce package",
        "publish:marketplace": "pnpm check && vsce publish",
        "vscode:prepublish": "node src/build.ts && node scripts/contrast-audit.ts"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.3",
        "@vitest/coverage-v8": "4.1.11",
        "@vscode/vsce": "3.9.2",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.11.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "vitest": "4.1.11"
    },
    "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037",
    "vsce": {
        "dependencies": false
    }
}
